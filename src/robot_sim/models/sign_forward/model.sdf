<?xml version="1.0"?>
<sdf version="1.6">
  <model name="sign_forward">

    <static>true</static>

    <link name="link">

      <visual name="post_visual">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.015</radius><length>0.1</length></cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
        </material>
      </visual>

      <collision name="post_collision">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.015</radius><length>0.1</length></cylinder>
        </geometry>
      </collision>

      <visual name="sign_visual">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry>
          <box><size>0.10 0.01 0.10</size></box>
        </geometry>
        <material>
          <script>
            <uri>model://sign_forward/materials/scripts</uri>
            <uri>model://sign_forward/materials/textures</uri>
            <name>sign_forward/Diffuse</name>
          </script>
        </material>
      </visual>

      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.01</iyy><iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>

    </link>
  </model>
</sdf>
