<?xml version="1.0"?>
<sdf version="1.6">
  <model name="track_cross_intersection">
    <static>true</static>
    <link name="link">

      <!-- Road surface: East-West arm (1.5 m × 0.5 m) -->
      <visual name="v001">
        <pose>0 0 0.001 0 0 0</pose>
        <geometry><box><size>1.000 0.50000 0.00200</size></box></geometry>
        <material>
          <ambient>0.180 0.180 0.180 1</ambient>
          <diffuse>0.180 0.180 0.180 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <!-- Road surface: North-South arm (0.5 m × 1.5 m) -->
