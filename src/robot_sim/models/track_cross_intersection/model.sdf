      <!-- ── Sidelines ─────────────────────────────────────────────────────────
        Matching straight track: 3 cm wide at ±0.235 m from road centre.
        Each shortened arm spans 0.5 m (centred at ±0.25 m).                 -->

      <!-- North arm sidelines (run N-S along x = ±0.235) -->
      <visual name="v003"><pose>-0.235  0.250 0.004 0 0 0</pose><geometry><box><size>0.030 0.500 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
