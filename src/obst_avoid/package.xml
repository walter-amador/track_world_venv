<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>obst_avoid</name>
  <version>0.1.0</version>
  <description>
    Monocular depth estimation benchmark and depth-based obstacle avoidance
    PoC for the LIMO robot simulation.  Supports MiDaS, Depth Anything V2,
    ZoeDepth, and Apple Depth Pro (one model active at a time).
  </description>
  <maintainer email="amadorwalter3418@gmail.com">walter-amador</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>python3-opencv</depend>
  <depend>python3-numpy</depend>

  <buildtool_depend>ament_python</buildtool_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
